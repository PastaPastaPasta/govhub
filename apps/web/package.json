{
  "name": "@govhub/web",
  "version": "0.0.0",
  "private": true,
  "description": "govhub web app: read-only Dash governance portal reading Platform with proofs (phase 1).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:live": "GOVHUB_LIVE=1 playwright test --grep @live",
    "screenshots": "SCREENSHOTS=1 playwright test --grep @screenshots",
    "record:dapi": "node scripts/record-dapi.mjs"
  },
  "dependencies": {
    "@dashevo/evo-sdk": "5.0.0-rc.8",
    "@fontsource-variable/archivo": "^5.2.6",
    "@govhub/contracts-v1": "*",
    "@govhub/verify": "*",
    "@noble/curves": "^2.0.0",
    "@noble/hashes": "^2.0.0",
    "@scure/base": "^2.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.1.3",
    "vitest": "^3.0.0"
  }
}
