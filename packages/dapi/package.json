{
  "name": "@govhub/dapi",
  "version": "0.0.0",
  "private": true,
  "description": "Browser-first grpc-web client for DAPI Core endpoints on Dash evonodes: transactions, blocks, ChainLocks, SML, bloom-filtered streams.",
  "type": "module",
  "sideEffects": false,
  "engines": { "node": ">=22" },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./bls": "./src/bls.ts",
    "./x11": "./src/x11.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:live": "node test/live/run.mjs",
    "typecheck": "tsc --noEmit",
    "size": "node scripts/size.mjs"
  },
  "dependencies": {
    "@dashevo/x11-hash-js": "^1.0.2",
    "@noble/curves": "^2.0.0",
    "@noble/hashes": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
