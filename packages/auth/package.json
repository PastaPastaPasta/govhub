{
  "name": "@govhub/auth",
  "version": "0.0.0",
  "private": true,
  "description": "Headless identity, login and funding for govhub: Dash seed (BIP39 + DIP-13), key paste, passkey vault (HPKE + WebAuthn PRF), asset-lock funding over DAPI.",
  "type": "module",
  "sideEffects": false,
  "engines": { "node": ">=22" },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./evo": "./src/evo.ts",
    "./keyring-evo": "./src/keyring/evo-store.ts",
    "./webauthn": "./src/vault/webauthn.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@govhub/dapi": "*",
    "@govhub/verify": "*",
    "@noble/ciphers": "^2.0.0",
    "@noble/curves": "^2.0.0",
    "@noble/hashes": "^2.0.0",
    "@scure/base": "^2.0.0",
    "@scure/bip32": "^2.0.0",
    "@scure/bip39": "^2.0.0"
  },
  "devDependencies": {
    "@dashevo/evo-sdk": "5.0.0-rc.8",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
