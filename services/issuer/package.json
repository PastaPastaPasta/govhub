{
  "name": "@govhub/issuer",
  "version": "0.1.0",
  "private": true,
  "description": "govhub MN badge issuer (PLAN \u00a78.4): blind-signs badge tokens for masternodes that prove their voting key, with offline-generated per-epoch RSA keys.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "issuer": "./bin/issuer.mjs"
  },
  "scripts": {
    "issuer": "node ./bin/issuer.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json"
  },
  "dependencies": {
    "@dashevo/evo-sdk": "5.0.0-rc.8",
    "@govhub/auth": "*",
    "@govhub/badge": "*",
    "@govhub/contracts-v1": "*",
    "@govhub/verify": "*",
    "@hono/node-server": "^1.14.0",
    "better-sqlite3": "^12.4.1",
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "typescript": "~5.9.2",
    "vitest": "^3.0.0",
    "@noble/curves": "^2.0.0"
  }
}
