{
  "name": "@govhub/bridge",
  "version": "0.1.0",
  "private": true,
  "description": "govhub bridge: archives Dash Core governance objects and signed votes, verifies them, publishes proposal/tally/cycle documents to the Platform gov contract and serves a read-only HTTP API.",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "bin": { "bridge": "./bin/bridge.mjs" },
  "scripts": {
    "bridge": "node ./bin/bridge.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dashevo/evo-sdk": "5.0.0-rc.8",
    "@govhub/verify": "*",
    "@hono/node-server": "^1.14.0",
    "@noble/hashes": "^2.0.0",
    "better-sqlite3": "^12.4.1",
    "hono": "^4.7.0",
    "zeromq": "^6.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "typescript": "~5.9.2",
    "vitest": "^3.0.0"
  }
}
