# govhub backend: operator configuration. Copy to `.env` (scripts/init.sh does it for you).
# This file holds NO secrets. The RPC password and the bridge identity key live in files under
# SECRETS_DIR, never here.
#
# Syntax: plain KEY=value, no quotes, no spaces around `=`. An empty value means "default".

# =================================================================================================
# 1. Which stack
# =================================================================================================

# Compose files to layer (separator is ':'). Pick ONE network line.
#   mainnet:  docker-compose.yml
#   testnet:  docker-compose.yml:docker-compose.testnet.yml
#   regtest:  docker-compose.yml:docker-compose.regtest.yml   (CI and smoke tests only)
# Add docker-compose.p2p.yml to publish dashd's P2P port (then set DASHD_P2P_PORT below).
COMPOSE_FILE=docker-compose.yml

# Optional profiles (separator is ','). `tunnel` adds cloudflared (publish through a Cloudflare Tunnel,
# no inbound ports; README section 11). `proxy` adds the caddy TLS reverse proxy instead.
COMPOSE_PROFILES=

# Compose project name. It prefixes the container, network and VOLUME names (govhub_dashd-data,
# govhub_bridge-data). Two stacks on one host (say mainnet and testnet) MUST have different project
# names, different GOVHUB_SUBNET, BRIDGE_PORT and BRIDGE_TAG, or the second `up` replaces the first
# and shares its volumes (or its bridge image). scripts/init.sh --network sets all four per network.
COMPOSE_PROJECT_NAME=govhub

# Where scripts/init.sh keeps the secret files. Relative paths are relative to this directory.
# The directory must be mode 0700 and must not be in version control.
SECRETS_DIR=./secrets

# Compose network subnet. dashd only accepts RPC from this range. Change it if it overlaps a
# network you already use (ip route, docker network ls).
GOVHUB_SUBNET=172.29.73.0/24

# =================================================================================================
# 2. dashd (Dash Core)
# =================================================================================================

# Image tag of dashpay/dashd. Defaults per network:
#   mainnet 24.0.0-rc.4   (mainnet needs >= 23.1; v24 serves quorum proofs; moves to 24.0.0 when released.
#                          It was 23.1.8 until 2026-10-25: set DASHD_TAG=23.1.8 to stay there, see README section 7)
#   testnet 24.0.0-rc.4   (testnet activated V24 on 2026-10-23, so it needs a v24 release candidate)
#   regtest 24.0.0-rc.4
# Pin an exact version. Never use `latest`: a Core upgrade must be a decision, not an accident.
# DASHD_TAG=

# RPC user name. The matching password is the file ${SECRETS_DIR}/core_rpc_password.
CORE_RPC_USER=govhub

# UTXO cache in MiB. 1024 suits a 4 GiB+ host. Raise it to 4096 or more for the initial sync if
# you have the RAM (then lower it again), because the cache is flushed at every restart.
DASHD_DBCACHE_MB=1024

# Cap on peer connections (Core's default is 125). 40 is plenty for a bridge node. Empty = default.
DASHD_MAXCONNECTIONS=

# P2P port, only used with docker-compose.p2p.yml: mainnet 9999, testnet 19999.
# DASHD_P2P_PORT=9999
# DASHD_P2P_BIND=0.0.0.0
# Public address to announce to peers, if you publish P2P and Core cannot discover it.
# DASHD_EXTERNALIP=

# Extra dashd flags, word-split, e.g. "-reindex" or "-maxuploadtarget=5000".
DASHD_EXTRA_ARGS=

# How long the container may take to answer RPC before it counts as unhealthy. A restart after an
# unclean stop can replay blocks for a long time on mainnet. The bridge waits for this health check.
DASHD_HEALTH_START_PERIOD=15m

# =================================================================================================
# 3. bridge
# =================================================================================================

# Whether the bridge writes to Dash Platform.
#   1 = publish proposal/tally/cycle documents to YOUR gov contract (needs GOV_CONTRACT_ID and
#       the identity key file, see README "Platform identity and contract").
#   0 = archive and serve only. No contract, no identity, no DASH needed. Start here: the archive
#       is history Core throws away, and it only grows while the bridge is running.
# The regtest override forces 0. Empty also means 0.
PUBLISH=0

# Platform network the documents go to. Empty = the same as Core (mainnet -> mainnet,
# testnet -> testnet). Only set it to run a testnet bridge against another network on purpose.
PLATFORM_NETWORK=

# Id (base58) of the gov contract the bridge publishes to. Third-party bridges register their own
# contract: owner-only creation, see README "Registering your own gov contract". Required when
# PUBLISH=1.
GOV_CONTRACT_ID=

# HTTP API, published on the host. Loopback by default; use the proxy profile for TLS, or set
# BRIDGE_BIND=0.0.0.0 to serve it directly (plain HTTP, no CORS handling beyond what the bridge does).
BRIDGE_BIND=127.0.0.1
BRIDGE_PORT=8787

# Tag of the locally built bridge image (govhub-bridge:<tag>). Give every stack on a host its own tag
# (init.sh: local / testnet / regtest), or a build in one checkout replaces the image of the other.
BRIDGE_TAG=local

# Optional bridge tunables. Empty = the bridge's built-in default.
BRIDGE_LOG_LEVEL=
CORE_RPC_TIMEOUT_MS=
CORE_RPC_RETRIES=
# How often the bridge reconciles with `gobject list` (seconds, min 10). ZMQ is the primary feed.
RECONCILE_INTERVAL_S=
# How often tally and cycle documents may be replaced on Platform, in seconds (each costs credits).
TALLY_PUBLISH_INTERVAL_S=
CYCLE_PUBLISH_INTERVAL_S=
# Confirmations a collateral needs before the proposal document is published.
MIN_COLLATERAL_CONFS=
# Concurrent Platform writes (nonce window; 12 is the hard ceiling).
PLATFORM_MAX_CONCURRENT_WRITES=
# 1 = publish a tally even when it disagrees with Core's FundingResult. Leave empty (hold and log).
PUBLISH_ON_MISMATCH=
# Link template for the DashCentral-compatible API; {hash} and {name} are substituted.
PORTAL_PROPOSAL_URL=

# =================================================================================================
# 4. caddy (profile `proxy`)
# =================================================================================================

# Public host name. DNS must point at this machine and ports 80/443 must be reachable.
# `localhost` uses Caddy's internal CA (fine for testing).
DOMAIN=localhost
# Access-Control-Allow-Origin for the read-only API. `*` lets browsers on any origin read it.
CORS_ALLOW_ORIGIN=*
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
# CADDY_TAG=2-alpine

# =================================================================================================
# 5. cloudflared (profile `tunnel`)
# =================================================================================================

# The tunnel token is the file ${SECRETS_DIR}/cloudflare_tunnel_token (scripts/cloudflare-tunnel.sh
# writes it). Never put it here. Hostnames and ingress are managed in Cloudflare, not in this file.
# CLOUDFLARED_TAG=2026.10.3

# One tunnel for two stacks on this host (README section 11.3).
# On the stack WITHOUT cloudflared, add docker-compose.tunnel-guest.yml to COMPOSE_FILE. Its gateway is reachable
# from the other stack's cloudflared as http://<TUNNEL_ALIAS>:8787 (default <project>-bridge, e.g. govhub-testnet-bridge).
# TUNNEL_ALIAS=
# On the stack WITH cloudflared, add docker-compose.tunnel-host.yml to COMPOSE_FILE and name the guest's network
# (<guest project>_tunnel, default govhub-testnet_tunnel).
# TUNNEL_GUEST_NETWORK=

# =================================================================================================
# 6. relay (profile `relay`): holds signed masternode votes until their release time, then voteraw
# ==========================================================================================
# =================================================================================================
# Enable with COMPOSE_PROFILES=relay (add `tunnel` to publish it). Uses this stack's dashd and RPC secret.
# Host port (loopback by default); a second stack on the same host needs another port.
# RELAY_BIND=127.0.0.1
# RELAY_PORT=8790
# RELAY_TAG=local
# Client address header from the proxy in front (kept in memory only, for rate limits). cloudflared
# sends cf-connecting-ip; set x-forwarded-for behind caddy (the relay uses its rightmost entry). If anything but the proxy can
# reach RELAY_PORT, also set RELAY_TRUSTED_PROXY_CIDRS to the proxy's address.
# RELAY_CLIENT_IP_HEADER=cf-connecting-ip
# Optional tunables (empty = the relay's default, services/relay/README.md):
# RELAY_LOG_LEVEL=
# RELAY_RELEASE_MARGIN_S=
# RELAY_MAX_HOLD_S=
# RELAY_MAX_HELD_PER_MN=
# RELAY_RATE_IP_PER_MIN=
# RELAY_RATE_MN_PER_HOUR=
# RELAY_PROPOSAL_SUBMIT=
# RELAY_RETENTION_DAYS=
# RELAY_MAX_PAST_S=
# RELAY_MAX_HELD_TOTAL=
# RELAY_TRUSTED_PROXY_CIDRS=
# Publishing a second stack's relay through this host's tunnel: docker-compose.relay-tunnel-guest.yml (after
# docker-compose.tunnel-guest.yml; the gateway forwards to the relay, which never joins the tunnel network).
# =================================================================================================
# 7. issuer (profile `issuer`; services/issuer/README.md)
# =================================================================================================

# The issuer identity (base58) that owns the issuerKey documents, and the `badge` contract they are in.
# testnet (project issuer): ISSUER_IDENTITY_ID=H62hSf5TpKbUSMov85GMhPQahZDbqsTipeoBsYPgveUH
#                           BADGE_CONTRACT_ID=2aYj4Dkix7xXBUTZFCDBjpcqqLi9Tg5oUwBgHUJBNGCU
ISSUER_IDENTITY_ID=
BADGE_CONTRACT_ID=
# How many keys for epochs AFTER the one being issued may sit in ${SECRETS_DIR}/issuer-keys. PLAN §8.4:
# the server holds only the current key; 1 lets the roll-over happen without an operator at the boundary.
# A higher value is a testnet convenience (testnet epochs are one day): every staged key is a future
# epoch a server compromise could mint badges for.
ISSUER_MAX_STAGED_KEYS=1
# HTTP, published on the host. Loopback by default; publish it through the tunnel under its own hostname.
ISSUER_BIND=127.0.0.1
ISSUER_PORT=8789
ISSUER_TAG=local
# Optional tunables. Empty = default (challenge TTL 600 s, 2000 requests per second into signature recovery).
ISSUER_CHALLENGE_TTL_S=
ISSUER_MAX_TOKEN_RPS=
ISSUER_LOG_LEVEL=
# Starter tokens (one free starter credit per masternode or proposal; services/issuer/README.md "Starter tokens"). Off while
# empty. Its own identity (never ISSUER_IDENTITY_ID), its keys in ${SECRETS_DIR}/starter-keys, its store
# /data-starter/starter.sqlite in its own volume `starter-data` (lifetime dedup: losing it re-opens every starter). Back it up
# RARELY: at most once per epoch after the closed window's retry data is cleared, latest copy only, encrypted, without its mtime,
# and exclude it from Proxmox/ZFS/VM snapshots; frequent dated copies show who took a starter when (services/issuer/README.md).
# testnet: STARTER_ISSUER_IDENTITY_ID=9Jwa6v2Bwj9TtDmgJGn3KV9qqXprYZUBEkKzkxzx3HD8
STARTER_ISSUER_IDENTITY_ID=
STARTER_MAX_STAGED_KEYS=1
# Empty = default (challenge TTL 1800 s: proposal owners sign by hand; proposals that ended up to 30 days ago are eligible).
STARTER_CHALLENGE_TTL_S=
STARTER_PROPOSAL_GRACE_DAYS=

# =================================================================================================
# 8. Future services (not implemented yet; names reserved)
# =================================================================================================
# accounts gets its own section here when its service lands.
