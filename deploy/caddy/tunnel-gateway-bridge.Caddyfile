# tunnel-gateway with the bridge only (docker-compose.tunnel-guest.yml): the guest stack's ONLY service on the shared `tunnel`
# network forwards to the bridge (8787). Plain HTTP; TLS ends at Cloudflare. The bridge sets its own CORS headers and answers
# GET/HEAD/OPTIONS (and its one read-only POST) itself; the gateway only forwards.
# No logs at all: there is no access log (no `log` directive), and the default logger, which writes handler and proxy errors
# with the request (client address, headers) to stdout that Docker keeps, is discarded. deploy-lint checks this for every
# tunnel-gateway-*.Caddyfile. (`caddy reverse-proxy` on the command line cannot turn that logger off, hence this file.)
{
	admin off
	auto_https off
	persist_config off
	log default {
		output discard
	}
}

:8787 {
	reverse_proxy bridge:8787
}
