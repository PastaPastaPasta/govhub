# TLS reverse proxy for the bridge's read-only API (compose profile `proxy`).
#
#   DOMAIN             public host name (DNS must point here; ports 80 and 443 must be reachable).
#                      `localhost` uses Caddy's internal CA, which is fine for testing.
#   CORS_ALLOW_ORIGIN  value of Access-Control-Allow-Origin. `*` is right for a public read-only API
#                      that browsers on any origin (the govhub frontend, other portals) may read.
#
# Only GET, HEAD, OPTIONS and POST /v1/quorum-proof reach the bridge. Dashd's RPC and ZMQ are never proxied.
#
# No request logs: there is no access log (no `log` directive in the site block), and the default logger, which writes handler
# and proxy errors with the request (client address, headers) to stdout that Docker keeps, is discarded. Only the certificate
# management loggers (ACME obtain/renew, cache maintenance) are kept, on stderr, so a failing certificate stays visible; they
# carry host names and ACME errors, not client addresses. `tls.handshake` (client addresses) and every http.* logger stay
# discarded. deploy-lint checks this against an allowlist of those namespaces; the tunnel gateways discard everything.
{
	log default {
		output discard
	}
	log certs {
		output stderr
		include tls.obtain tls.renew tls.issuance.acme tls.issuance.zerossl tls.cache.maintenance http.acme_client
	}
}

{$DOMAIN:localhost} {
	encode zstd gzip

	# The proxy owns CORS, so a bridge that also sets CORS headers cannot produce duplicates.
	header {
		Access-Control-Allow-Origin "{$CORS_ALLOW_ORIGIN:*}"
		Access-Control-Allow-Methods "GET, HEAD, POST, OPTIONS"
		Access-Control-Allow-Headers "Content-Type, If-None-Match"
		Access-Control-Expose-Headers "ETag, Content-Length, X-Proof-Target-Height, X-Proof-Format, Retry-After"
		Access-Control-Max-Age "86400"
		Vary "Origin"
		X-Content-Type-Options "nosniff"
		-Server
	}

	@preflight method OPTIONS
	handle @preflight {
		respond 204
	}

	# the one write-shaped read: POST /v1/quorum-proof takes the quorum list server's JSON body (services/bridge/README.md)
	@proofpost {
		method POST
		path /v1/quorum-proof
	}
	handle @proofpost {
		request_body {
			max_size 1KB
		}
		reverse_proxy bridge:8787 {
			header_up Cf-Connecting-Ip {remote_host}
			header_down -Access-Control-Allow-Origin
			header_down -Access-Control-Allow-Methods
			header_down -Access-Control-Allow-Headers
			header_down -Access-Control-Expose-Headers
			header_down -Access-Control-Max-Age
		}
	}

	@readonly method GET HEAD
	handle @readonly {
		reverse_proxy bridge:8787 {
			# the bridge rate-limits /v1/quorum-proof per client by this header (CLIENT_IP_HEADER): never let a client choose it
			header_up Cf-Connecting-Ip {remote_host}
			header_down -Access-Control-Allow-Origin
			header_down -Access-Control-Allow-Methods
			header_down -Access-Control-Allow-Headers
			header_down -Access-Control-Expose-Headers
			header_down -Access-Control-Max-Age
		}
	}

	handle {
		respond "read-only API" 405
	}
}
